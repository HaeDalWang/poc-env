aws_region  = "ap-northeast-2"
project_name = "geoip-opt2"
cluster_name = "REPLACE_WITH_EKS_CLUSTER_NAME"
vpc_id       = "REPLACE_WITH_VPC_ID"

public_subnet_ids = [
  "REPLACE_WITH_PUBLIC_SUBNET_A",
  "REPLACE_WITH_PUBLIC_SUBNET_B",
]

private_subnet_ids = [
  "REPLACE_WITH_PRIVATE_SUBNET_A",
  "REPLACE_WITH_PRIVATE_SUBNET_B",
]

private_subnet_cidrs = [
  "REPLACE_WITH_PRIVATE_SUBNET_CIDR_A",
  "REPLACE_WITH_PRIVATE_SUBNET_CIDR_B",
]

traefik_target_security_group_id       = "REPLACE_WITH_TARGET_SECURITY_GROUP_ID"
acknowledge_target_security_group_change = false
certificate_arn                        = "REPLACE_WITH_ACM_CERTIFICATE_ARN"
hosted_zone_id                         = "REPLACE_WITH_PUBLIC_HOSTED_ZONE_ID"

protected_hosts = [
  "geoip-opt2.seungdobae.com",
]

allowed_ipv4_cidrs = [
  "REPLACE_WITH_TEST_CLIENT_CIDR",
]

# Keep false until both target groups are healthy, the readiness gate is
# present after a Traefik rollout, and the WAF association is verified.
create_dns_records = false

# Keep COUNT until the request matrix and false-positive evidence are reviewed.
waf_mode = "count"

tags = {
  Owner      = "poc"
  ReviewDate = "2026-08-20"
}
