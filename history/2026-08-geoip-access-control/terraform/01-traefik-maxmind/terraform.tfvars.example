aws_region   = "ap-northeast-2"
project_name = "geoip-opt1"
cluster_name = "REPLACE_WITH_EKS_CLUSTER_NAME"
vpc_id       = "REPLACE_WITH_VPC_ID"

public_subnet_ids = [
  "REPLACE_WITH_PUBLIC_SUBNET_A",
  "REPLACE_WITH_PUBLIC_SUBNET_B",
]

certificate_arn = "REPLACE_WITH_ACM_CERTIFICATE_ARN"
hosted_zone_id  = "REPLACE_WITH_PUBLIC_HOSTED_ZONE_ID"

protected_hosts = [
  "geoip-opt1.example.invalid",
]

control_host = "geoip-opt1-control.example.invalid"

required_poc_dns_suffix = ".example.invalid"

# Narrow the NLB to the address the tests actually come from.
allowed_ipv4_cidrs = [
  "REPLACE_WITH_TEST_CLIENT_CIDR",
]

create_dns_records = false

# wsdl_only reproduces the customer's literal request; path_all shows what the
# narrow scope leaves open. Run both.
protected_scope = "wsdl_only"

# MaxMind credentials never live in a tfvars file:
#   export TF_VAR_maxmind_account_id=...
#   export TF_VAR_maxmind_license_key=...

tags = {
  Owner      = "poc"
  ReviewDate = "2026-08-20"
}
