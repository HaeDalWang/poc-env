# 이 파일을 terraform.tfvars로 복사한 뒤 값을 채운다.
# terraform.tfvars는 .gitignore 대상이라 커밋되지 않는다.

# ------------------------------------------------------------------------------
# 기반 스택(terraform-eks) 식별
# project는 terraform-eks/terraform.tfvars의 project와 반드시 같아야 한다.
# ------------------------------------------------------------------------------
region  = "ap-northeast-2"
project = "eks-poc"

# ------------------------------------------------------------------------------
# 이 스택
# ------------------------------------------------------------------------------
stack = "sandbox-helm"

# namespace를 지정하지 않으면 stack 값이 네임스페이스가 된다.
# namespace        = "sandbox-helm"
# create_namespace = true

tags = {
  Owner = "platform"
}

# ------------------------------------------------------------------------------
# 선택 조회. 쓰지 않으면 지우거나 빈 문자열로 둔다.
# ------------------------------------------------------------------------------
route53_zone_name      = "seungdobae.com"
acm_certificate_domain = "seungdobae.com"

# ------------------------------------------------------------------------------
# 차트 버전은 여기서 고정한다. (variables.tf에 변수를 추가한 뒤 사용)
# 최신화: YYYY년 M월 D일
# ------------------------------------------------------------------------------
# example_chart_version = "1.0.0"
